# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp

# Входные и выходные данные — содержимое не версонируется,
# но сами папки сохранены через .gitkeep (видны на GitHub).
input/*
!input/.gitkeep
!input/README.md
output/*
!output/.gitkeep
!output/README.md

# Артефакты сборки и релизов
dist/
wheels/
*.zip

# Временные файлы moviepy
*_TEMP_MPY_*
